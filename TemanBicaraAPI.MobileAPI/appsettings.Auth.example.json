{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ColdDb": "Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=VerifyFull"
  },
  "Auth": {
    "VerificationHashKey": "BASE64_ENCODED_32_RANDOM_BYTES",
    "KeyRingPath": "ABSOLUTE_PRIVATE_DIRECTORY_OUTSIDE_REPOSITORY",
    "RequestsPerMinute": 10
  },
  "Smtp": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "Security": "StartTls",
    "From": "TemanBicara <YOUR_SENDER_EMAIL>",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD"
  }
}
